# PayPal sandbox REST app credentials (developer.paypal.com > Apps & Credentials > Sandbox)
# Leave blank to run in simulated mode (no real PayPal calls).
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com

# Google AI Studio key (aistudio.google.com). Leave blank to use the offline fallback parser.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Approximate INR->USD rate used because PayPal sandbox invoicing is billed in USD
INR_PER_USD=88
